<div id="<%= dom_id book %>">
  <dl class="divide-y divide-gray-100">
    <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Title</dt>
      <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= book.title %></dd>
    </div>

    <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Description</dt>
      <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
        <% if book.description.present? %>
          <%= simple_format h(book.description), class: "mb-2 last:mb-0" %>
        <% else %>
          <span class="text-gray-500">No description</span>
        <% end %>
      </dd>
    </div>

    <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Category</dt>
      <dd class="mt-1 text-sm sm:col-span-2 sm:mt-0"><%= link_to book.category.name, book.category, class: "text-sm font-medium text-blue-600 hover:text-blue-500" %></dd>
    </div>

    <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Authors</dt>
      <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
        <% if book.authors.present? %>
          <%= safe_join(book.authors.map { |author| link_to author.name, author, class: "text-sm font-medium text-blue-600 hover:text-blue-500" }, ", ") %>
        <% else %>
          <span class="text-gray-500">No authors</span>
        <% end %>
      </dd>
    </div>
  </dl>
</div>
