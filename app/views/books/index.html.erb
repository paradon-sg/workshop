<% content_for :title, "Books" %>

<%= render "layouts/flash" %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-gray-900">Books</h1>
  <%= link_to "New book", new_book_path, class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-500" %>
</div>

<%= form_with url: books_path, method: :get, class: "mb-4 flex gap-2" do |form| %>
  <%= form.label :query, "Search by title", class: "sr-only" %>
  <%= form.search_field :query, value: @query, placeholder: "Search by title", class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm" %>
  <%= form.submit "Search", name: nil, class: "rounded-md bg-gray-100 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-200" %>
<% end %>

<div id="books" class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
  <% if @books.any? %>
    <ul class="divide-y divide-gray-200">
      <% @books.each do |book| %>
        <li id="<%= dom_id book %>" class="flex items-center justify-between gap-4 px-5 py-4">
          <div class="min-w-0">
            <p class="truncate font-medium text-gray-900"><%= book.title %></p>
            <p class="truncate text-sm text-gray-500">
              <%= book.category.name %><% if book.authors.any? %> · <%= book.authors.map(&:name).join(", ") %><% end %>
            </p>
          </div>
          <%= link_to "Show this book", book, class: "shrink-0 text-sm font-medium text-blue-600 hover:text-blue-500" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="px-5 py-10 text-center text-sm text-gray-500"><%= @query.present? ? "No books match \"#{@query}\"." : "No books yet." %></p>
  <% end %>
</div>
