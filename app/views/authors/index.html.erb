<% content_for :title, "Authors" %>

<%= render "layouts/flash" %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-gray-900">Authors</h1>
  <%= link_to "New author", new_author_path, class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-500" %>
</div>

<div id="authors" class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
  <% if @authors.any? %>
    <ul class="divide-y divide-gray-200">
      <% @authors.each do |author| %>
        <li id="<%= dom_id author %>" class="flex items-center justify-between gap-4 px-5 py-4">
          <div class="min-w-0 truncate font-medium text-gray-900"><%= author.name %></div>
          <%= link_to "Show this author", author, class: "shrink-0 text-sm font-medium text-blue-600 hover:text-blue-500" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="px-5 py-10 text-center text-sm text-gray-500">No authors yet.</p>
  <% end %>
</div>
