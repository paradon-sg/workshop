<% content_for :title, "Editing author" %>

<h1 class="mb-6 text-2xl font-bold text-gray-900">Editing author</h1>

<div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
  <%= render "form", author: @author %>
</div>

<div class="mt-6 flex gap-4">
  <%= link_to "Show this author", @author, class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
  <%= link_to "Back to authors", authors_path, class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
</div>
