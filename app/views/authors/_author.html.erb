<div id="<%= dom_id author %>">
  <dl class="divide-y divide-gray-100">
    <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Name</dt>
      <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= author.name %></dd>
    </div>

    <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Description</dt>
      <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
        <% if author.description.present? %>
          <%= simple_format h(author.description), class: "mb-2 last:mb-0" %>
        <% else %>
          <span class="text-gray-500">No description</span>
        <% end %>
      </dd>
    </div>
  </dl>
</div>
