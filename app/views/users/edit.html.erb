<% content_for :title, "Editing user" %>

<h1 class="mb-6 text-2xl font-bold text-gray-900">Editing user</h1>

<div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
  <%= render "form", user: @user %>
</div>

<div class="mt-6 flex gap-4 text-sm font-medium">
  <%= link_to "Show this user", @user, class: "text-blue-600 hover:text-blue-500" %>
  <%= link_to "Back to users", users_path, class: "text-blue-600 hover:text-blue-500" %>
</div>
